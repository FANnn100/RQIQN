# Frozen RQIQN-only configuration reconstructed from the archived Alien runs.
# This release contains the required training implementation. No historical
# results or checkpoints are included. New results are recorded by train_alien.py.
import dopamine.jax.agents.implicit_quantile.rqiqn_agent
import dopamine.discrete_domains.atari_lib
import dopamine.discrete_domains.run_experiment
import dopamine.replay_memory.circular_replay_buffer

create_agent.agent_name = 'jax_rqiqn'
create_agent.debug_mode = False
create_runner.schedule = 'continuous_train'
atari_lib.create_atari_environment.game_name = 'Alien'
atari_lib.create_atari_environment.sticky_actions = True
AtariPreprocessing.frame_skip = 4
AtariPreprocessing.terminal_on_life_loss = False
AtariPreprocessing.screen_size = 84
Runner.num_iterations = 200
Runner.training_steps = 250000
Runner.evaluation_steps = 125000
Runner.max_steps_per_episode = 27000
Runner.clip_rewards = 'One'
JaxRQIQNAgent.kappa = 1.0
JaxRQIQNAgent.num_tau_samples = 64
JaxRQIQNAgent.num_tau_prime_samples = 64
JaxRQIQNAgent.num_quantile_samples = 32
JaxRQIQNAgent.gamma = 0.99
JaxRQIQNAgent.update_horizon = 3
JaxRQIQNAgent.min_replay_history = 20000
JaxRQIQNAgent.update_period = 4
JaxRQIQNAgent.target_update_period = 8000
JaxRQIQNAgent.epsilon_train = 0.01
JaxRQIQNAgent.epsilon_eval = 0.001
JaxRQIQNAgent.epsilon_decay_period = 250000
JaxRQIQNAgent.optimizer = 'adam'
create_optimizer.learning_rate = 0.00005
create_optimizer.eps = 0.0003125
JaxRQIQNAgent.robust_epsilon_init = 1.0
JaxRQIQNAgent.wasserstein_p = 2.0
JaxRQIQNAgent.robust_sign = 1.0
JaxRQIQNAgent.robust_decay = 'logistic'
JaxRQIQNAgent.robust_decay_period = 1000000
JaxRQIQNAgent.robust_decay_warmup_iterations = 0
JaxRQIQNAgent.robust_decay_iteration_steps = 250000
JaxRQIQNAgent.robust_logistic_k = 1.2e-6
JaxRQIQNAgent.robust_logistic_t0 = 3750000
JaxRQIQNAgent.loss_type = 'check'
JaxRQIQNAgent.state_action_mean_scaling = True
JaxRQIQNAgent.state_action_mean_scale_coeff = 1.0
JaxRQIQNAgent.state_action_mean_use_abs = True
JaxRQIQNAgent.state_action_mean_use_decay_multiplier = True
OutOfGraphReplayBuffer.replay_capacity = 1000000
OutOfGraphReplayBuffer.batch_size = 32
